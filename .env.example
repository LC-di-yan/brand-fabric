# ===== 运行模式 =====
# lite  : 无需 Docker，SQLite + 本地向量索引，用于快速体验与测试
# full  : Docker Compose（PostgreSQL + Milvus Standalone），完整形态
BDP_MODE=lite

# ===== 关系型存储 =====
# lite 模式默认 SQLite
BDP_DATABASE_URL=sqlite:///./data/bdp.db
# full 模式使用 PostgreSQL（docker-compose 内网地址）
# BDP_DATABASE_URL=postgresql+psycopg://bdp:bdp_pass@localhost:5433/bdp

# ===== 向量存储 =====
# milvus | local
BDP_VECTOR_BACKEND=local
BDP_MILVUS_URI=http://localhost:19530
BDP_MILVUS_USER=
BDP_MILVUS_PASSWORD=

# ===== Embedding =====
# hash   : 离线确定性哈希（默认，零依赖，保证任何机器都能跑）
# bge    : 本地 BGE 小模型（需 pip install sentence-transformers，约 100MB）
# openai : 兼容 OpenAI 协议的接口
BDP_EMBEDDING_BACKEND=hash
BDP_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
BDP_EMBEDDING_DIM=1024
BDP_EMBEDDING_API_BASE=
BDP_EMBEDDING_API_KEY=

# ===== 安全 =====
BDP_JWT_SECRET=change-me-in-production-please-use-a-long-random-string
BDP_JWT_ALGORITHM=HS256
BDP_JWT_EXPIRE_MINUTES=720

# ===== 模拟数据规模 =====
BDP_MOCK_SEED=20260926
BDP_MOCK_DAYS=90
BDP_MOCK_BRANDS=4

# ===== Agent 编排 =====
# worker 并发数（SQLite 单写者模式下强制为 1，PostgreSQL 建议 4）
BDP_AGENT_WORKERS=4
# 数据质量门禁：overall_pass_rate 低于该值视为 block
BDP_AGENT_DQ_GATE=0.99
# block 时的动作：skip（跳过指标物化）| degraded（带标记继续）
BDP_AGENT_DQ_GATE_ACTION=degraded
BDP_AGENT_HEARTBEAT_SEC=30
BDP_AGENT_EVENT_RETENTION_DAYS=14

# ===== LLM（InsightAgent 业务问答，可选） =====
# none : 不启用，问答走"指标卡片 + 检索片段"降级路径
# openai: 兼容 OpenAI /v1/chat/completions 协议的接口
BDP_LLM_BACKEND=none
BDP_LLM_MODEL=
BDP_LLM_API_BASE=
BDP_LLM_API_KEY=
BDP_LLM_TIMEOUT_SEC=60

# ===== Agentic RAG（检索管线，docs/AGENTIC_RAG_PLAN.md） =====
# single  : 现状直通（一次检索）
# agentic : 规划→检索→判定→改写/多跳→压缩→引用校验（无 LLM 走规则退化）
BDP_RAG_STRATEGY=single
BDP_RAG_MAX_REWRITES=2
BDP_RAG_MAX_HOPS=2
BDP_RAG_JUDGE_THRESHOLD=0.4
# heuristic | llm
BDP_RAG_JUDGE_BACKEND=heuristic
# lexical | bge（bge 需 pip install sentence-transformers）
BDP_RAG_RERANK_BACKEND=lexical
BDP_RAG_COMPRESS_TOKEN_BUDGET=3000
BDP_RAG_SESSION_TURNS=5
BDP_RAG_TOP_K=4

# ===== 日志 =====
BDP_LOG_LEVEL=INFO

# ===== CORS（可选） =====
# 默认为空 = 不启用 CORS（前端由本服务同源托管）。
# 需要跨域接入时显式列出来源白名单（逗号分隔），如：
# BDP_CORS_ORIGINS=http://localhost:5173,https://bi.example.com
